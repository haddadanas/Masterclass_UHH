{
    "exclude": [
        "node_modules",
        "dist",
    ],
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "moduleResolution": "node",
        "jsx": "preserve",
        "allowImportingTsExtensions": true,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "strictFunctionTypes": true
    },
}